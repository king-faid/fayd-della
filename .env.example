# Salin menjadi .env.local untuk dijalankan di komputer,
# dan isi yang sama di Vercel: Project Settings > Environment Variables.
# Nilainya ada di Supabase: Project Settings > API (atau Connect).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_publishable_atau_anon_key
